	(text "the direction of this board is designed to have the M12 connector facing the front of the car\nthe fpc on the opposite side of the board.\nin order to minimize fpc twist, the fpc oreientation should remain the same\nwhich is P on top, N at the bottom and channel 1 on top, channel 20 at the bottom."
		(exclude_from_sim no)
		(at 31.242 23.622 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "aca934f7-c749-4ced-b8aa-3b3d9cba2359")
	)
	(text "note that the pin direction is reversed from the VCU_CM4\nnote that the connector used in VCU_CM4 is intedded to be \nF32Q-1A7H1-11040 which is top contact.\nif we use a bottom contact type connecto on this board, then we should use opposite contact fpc.\nif we use a top contact type connector, then we should use same side contact fpc."
		(exclude_from_sim no)
		(at 30.988 36.83 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c64f09b8-20e0-4918-be34-d5e2f33df65b")
	)
